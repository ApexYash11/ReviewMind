# Copy this file to .env and fill in your values.
# The LLM provider is configurable - any OpenAI-compatible API works.

# Required: API key for your chosen provider.
LLM_API_KEY=

# Optional overrides (defaults come from config/config.yaml)
LLM_PROVIDER=openrouter
# Free tier. Choose a NON-reasoning model for speed: reasoning models spend
# 1-5 min per analysis, this one takes ~10-40s.
# Note: some ":free" models are gated to agentic harnesses only (HTTP 403).
LLM_MODEL=inclusionai/ling-3.0-flash-sante:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=6000
# Optional: cap the reasoning budget of reasoning models (0 = provider default).
# If the provider's thinking tokens exceed LLM_MAX_TOKENS you get an empty response.
LLM_MAX_REASONING_TOKENS=0
MAX_INPUT_CHARS=20000