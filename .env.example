# Copy this file to .env and fill in your values.
# The LLM provider is configurable - any OpenAI-compatible API works.
# Leave LLM_API_KEY empty to run in demo mode (local simulation, no network).

# Required: API key for your chosen provider.
LLM_API_KEY=

# Optional overrides (defaults come from config/config.yaml)
LLM_PROVIDER=openrouter
# Free tier. This one is a reasoning model, so keep LLM_MAX_REASONING_TOKENS
# below LLM_MAX_TOKENS - otherwise the thinking budget eats the whole answer
# and the client returns "the token budget was consumed by reasoning".
# Note: OpenRouter retires ":free" slugs regularly (HTTP 404), and some are
# gated to agentic harnesses only (HTTP 403). Check the current list at
# https://openrouter.ai/api/v1/models if a model stops responding.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=6000
# Optional: cap the reasoning budget of reasoning models (0 = provider default).
# If the provider's thinking tokens exceed LLM_MAX_TOKENS you get an empty response.
LLM_MAX_REASONING_TOKENS=2000
MAX_INPUT_CHARS=20000