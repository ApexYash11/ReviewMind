# Copy this file to .env and fill in your values.
# The LLM provider is configurable - any OpenAI-compatible API works.

# Required: API key for your chosen provider.
LLM_API_KEY=

# Optional overrides (defaults come from config/config.yaml)
LLM_PROVIDER=openrouter
# Free tier. Note: some ":free" models are gated to agentic harnesses only
# (OpenRouter returns HTTP 403) - swap in another free or paid model if so.
LLM_MODEL=liquid/lfm-2.5-2.6b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=6000
# Optional: cap the reasoning budget of reasoning models (0 = provider default).
# If the provider's thinking tokens exceed LLM_MAX_TOKENS you get an empty response.
LLM_MAX_REASONING_TOKENS=0
MAX_INPUT_CHARS=20000